{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-generated immutable input consumed by all downstream jobs.",
  "properties": {
    "analysis_view_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "minItems": 2,
      "title": "Analysis View Ids",
      "type": "array"
    },
    "analysis_view_set_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Analysis View Set Hash",
      "type": "string"
    },
    "cdc_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cdc Policy Hash",
      "type": "string"
    },
    "cdc_policy_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Cdc Policy Id",
      "type": "string"
    },
    "constraint_snapshot_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "constraint_snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Constraint Snapshot Hash",
      "type": "string"
    },
    "contract_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "defines": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_$]*(?:=.*)?$",
        "type": "string"
      },
      "title": "Defines",
      "type": "array"
    },
    "design_contract_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Design Contract Id",
      "type": "string"
    },
    "effective_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Effective Policy Hash",
      "type": "string"
    },
    "effective_policy_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Effective Policy Id",
      "type": "string"
    },
    "formal_compilation_profile_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Formal Compilation Profile Hash",
      "type": "string"
    },
    "formal_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Formal Policy Hash",
      "type": "string"
    },
    "formal_policy_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Formal Policy Id",
      "type": "string"
    },
    "functional_compilation_profile_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Functional Compilation Profile Hash",
      "type": "string"
    },
    "functional_source_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Functional Source Artifacts",
      "type": "array"
    },
    "organizer_decision_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Organizer Decision Hash",
      "type": "string"
    },
    "parameters": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_$]*$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "platform_lock_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Platform Lock Hash",
      "type": "string"
    },
    "power_activity_contract_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Power Activity Contract Hash"
    },
    "power_activity_contract_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Power Activity Contract Id"
    },
    "project_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Project Manifest Hash",
      "type": "string"
    },
    "protection_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protection Policy Hash",
      "type": "string"
    },
    "protection_policy_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Protection Policy Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "top": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Top",
      "type": "string"
    }
  },
  "required": [
    "design_contract_id",
    "run_id",
    "project_manifest_hash",
    "functional_source_artifacts",
    "top",
    "parameters",
    "defines",
    "functional_compilation_profile_hash",
    "formal_compilation_profile_hash",
    "constraint_snapshot_artifact",
    "constraint_snapshot_hash",
    "analysis_view_ids",
    "analysis_view_set_hash",
    "power_activity_contract_id",
    "power_activity_contract_hash",
    "platform_lock_hash",
    "cdc_policy_id",
    "cdc_policy_hash",
    "protection_policy_id",
    "protection_policy_hash",
    "formal_policy_id",
    "formal_policy_hash",
    "effective_policy_id",
    "effective_policy_hash",
    "organizer_decision_hash",
    "created_at",
    "contract_hash"
  ],
  "title": "DesignContract",
  "type": "object"
}
