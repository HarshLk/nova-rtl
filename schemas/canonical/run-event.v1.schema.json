{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "cpu_time_ms": {
          "minimum": 0,
          "title": "Cpu Time Ms",
          "type": "integer"
        },
        "peak_rss_bytes": {
          "minimum": 0,
          "title": "Peak Rss Bytes",
          "type": "integer"
        },
        "wall_time_ms": {
          "minimum": 0,
          "title": "Wall Time Ms",
          "type": "integer"
        }
      },
      "required": [
        "cpu_time_ms",
        "wall_time_ms",
        "peak_rss_bytes"
      ],
      "title": "ResourceUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only event whose sequence, not timestamp, defines replay order.",
  "properties": {
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "entity_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
      "title": "Entity Type",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "event_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
      "title": "Event Type",
      "type": "string"
    },
    "new_state": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "New State"
    },
    "payload_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "payload_schema_name": {
      "pattern": "^[a-z][a-z0-9-]{2,95}$",
      "title": "Payload Schema Name",
      "type": "string"
    },
    "payload_schema_version": {
      "exclusiveMinimum": 0,
      "title": "Payload Schema Version",
      "type": "integer"
    },
    "policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "prior_state": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prior State"
    },
    "resource_usage": {
      "$ref": "#/$defs/ResourceUsage"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "INFRASTRUCTURE_ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "event_type",
    "entity_type",
    "entity_id",
    "timestamp",
    "prior_state",
    "new_state",
    "policy_hash",
    "payload_schema_name",
    "payload_schema_version",
    "payload_artifact",
    "duration_ms",
    "resource_usage",
    "status",
    "error_code"
  ],
  "title": "RunEvent",
  "type": "object"
}
