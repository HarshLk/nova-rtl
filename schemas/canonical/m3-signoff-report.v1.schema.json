      "type": "integer"
    },
    "expected_master_clocks": {
      "const": 5,
      "title": "Expected Master Clocks",
      "type": "integer"
    },
    "graph_artifact_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Graph Artifact Hash",
      "type": "string"
    },
    "implementation_tree_hash": {
      "pattern": "^[0-9a-f]{40}$",
