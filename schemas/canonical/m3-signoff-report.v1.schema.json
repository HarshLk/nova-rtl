    "evidence_input_hash",
    "evidence_snapshot_hash",
    "graph_artifact_hash",
    "source_map_hash",
    "source_map_artifact_hash",
    "path_collection_hash",
    "path_record_artifact_hash",
    "cluster_collection_hash",
    "cluster_artifact_hash",
    "opportunity_policy_hash",
    "ranked_opportunity_artifact_hash",
    "ranking_hash",
    "path_count",
    "cluster_count",
    "opportunity_count",
    "editable_opportunity_count",
    "root_cause_counts",
    "editability_counts",
    "replay_digest",
    "ledger_hash",
    "input_set_hash",
    "report_hash"
