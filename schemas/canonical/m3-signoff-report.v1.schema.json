    "source_map_artifact_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Map Artifact Hash",
      "type": "string"
    },
    "source_map_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Map Hash",
      "type": "string"
    },
