      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "M2 Packet Hash",
      "type": "string"
    },
    "m2_report_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "M2 Report Hash",
      "type": "string"
    },
    "opportunity_count": {
      "exclusiveMinimum": 0,
      "title": "Opportunity Count",
      "type": "integer"
    },
    "opportunity_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Opportunity Policy Hash",
      "type": "string"
    },
    "opportunity_stage_result_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Opportunity Stage Result Hash",
      "type": "string"
    },
    "path_collection_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
