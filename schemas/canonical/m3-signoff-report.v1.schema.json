  "required": [
    "status",
    "commit_sha",
    "implementation_tree_hash",
    "m2_commit_sha",
    "m2_packet_hash",
    "m2_report_hash",
    "run_id",
    "profile",
    "expected_master_clocks",
    "expected_generated_clocks",
    "run_index_hash",
    "evidence_stage_result_hash",
