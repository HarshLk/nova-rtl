      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "editability_counts": {
      "patternProperties": {
        "^[A-Z][A-Z0-9_]{2,95}$": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "Editability Counts",
      "type": "object"
    },
    "editable_opportunity_count": {
      "exclusiveMinimum": 0,
      "title": "Editable Opportunity Count",
      "type": "integer"
    },
    "evidence_input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Input Hash",
      "type": "string"
    },
