      "type": "string"
    },
    "replay_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Replay Digest",
      "type": "string"
    },
    "report_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
