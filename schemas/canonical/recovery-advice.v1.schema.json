{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Stable semantic evidence address within an immutable snapshot.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "kind": {
          "enum": [
            "PATH",
            "ARC",
            "CONE",
            "SOURCE_SPAN",
            "CLOCK",
            "CDC",
            "BINDING",
            "PHYSICAL",
            "FORMAL",
            "METRIC",
            "HISTORY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "artifact_id",
        "json_pointer",
        "snapshot_hash"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Advisory recovery output with no budget or classification authority.",
  "properties": {
    "advisor_mode": {
      "enum": [
        "HEURISTIC",
        "SINGLE_AGENT",
        "AGENT_COUNCIL"
      ],
      "title": "Advisor Mode",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "failure_event_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Failure Event Id",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "proposed_action": {
      "enum": [
        "RETRY_INFRASTRUCTURE",
        "REPAIR_SCHEMA",
        "CORRECT_EXECUTOR_OUTPUT",
        "LOCAL_PARAMETER_REVISION",
        "NARROW_TRANSFORM_SCOPE",
        "SWITCH_OPERATION_SAME_FAMILY",
        "SWITCH_TRANSFORM_FAMILY",
        "OPPORTUNITY_REANALYSIS",
        "TARGET_NEW_PATH_CLUSTER",
        "BRANCH_FROM_ALTERNATE_PARENT",
        "REPARTITION_FORMAL_PROOF",
        "PHYSICAL_ONLY_RECOMMENDATION",
        "REJECT_CANDIDATE",
        "ABANDON_LINEAGE",
        "STOP_RUN_OR_REQUEST_HUMAN"
      ],
      "title": "Proposed Action",
      "type": "string"
    },
    "proposed_excluded_transform_families": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
        "type": "string"
      },
      "title": "Proposed Excluded Transform Families",
      "type": "array"
    },
    "proposed_parent_candidate_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Proposed Parent Candidate Id"
    },
    "rationale_codes": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Rationale Codes",
      "type": "array"
    },
    "recovery_advice_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Recovery Advice Id",
      "type": "string"
    },
    "recovery_request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Recovery Request Hash",
      "type": "string"
    },
    "recovery_request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Recovery Request Id",
      "type": "string"
    },
    "recovery_route_plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Recovery Route Plan Hash",
      "type": "string"
    },
    "recovery_route_plan_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Recovery Route Plan Id",
      "type": "string"
    },
    "repair_directive_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Repair Directive Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_role": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Role"
    },
    "uncertainty": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Uncertainty",
      "type": "number"
    }
  },
  "required": [
    "recovery_advice_id",
    "failure_event_id",
    "repair_directive_id",
    "recovery_request_id",
    "recovery_request_hash",
    "recovery_route_plan_id",
    "recovery_route_plan_hash",
    "advisor_mode",
    "selected_role",
    "proposed_action",
    "proposed_parent_candidate_id",
    "proposed_excluded_transform_families",
    "rationale_codes",
    "evidence_refs",
    "uncertainty",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "output_hash"
  ],
  "title": "RecoveryAdvice",
  "type": "object"
}
