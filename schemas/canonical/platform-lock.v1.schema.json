{
  "$defs": {
    "HostPlatform": {
      "additionalProperties": false,
      "description": "Supported host identity for one portable toolchain realization.",
      "properties": {
        "architecture": {
          "const": "x86_64",
          "title": "Architecture",
          "type": "string"
        },
        "os": {
          "const": "linux",
          "title": "Os",
          "type": "string"
        }
      },
      "required": [
        "os",
        "architecture"
      ],
      "title": "HostPlatform",
      "type": "object"
    },
    "PlatformArtifact": {
      "additionalProperties": false,
      "description": "Content-addressed platform input with portable and resolved identities.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "LIBERTY",
            "TECH_LEF",
            "CELL_LEF",
            "GDS",
            "RC_RULES",
            "FLOW_CONFIG",
            "SCRIPT",
            "MAPPING",
            "LICENSE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "resolved_path": {
          "format": "path",
          "title": "Resolved Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "logical_path",
        "resolved_path",
        "sha256",
        "size_bytes"
      ],
      "title": "PlatformArtifact",
      "type": "object"
    },
    "TimingCorner": {
      "additionalProperties": false,
      "description": "One immutable ASAP7 timing-corner identity.",
      "properties": {
        "corner_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Corner Id",
          "type": "string"
        },
        "liberty_files": {
          "items": {
            "$ref": "#/$defs/PlatformArtifact"
          },
          "minItems": 1,
          "title": "Liberty Files",
          "type": "array"
        },
        "library_model": {
          "enum": [
            "NLDM",
            "CCS"
          ],
          "title": "Library Model",
          "type": "string"
        },
        "native_time_unit": {
          "enum": [
            "PS",
            "NS"
          ],
          "title": "Native Time Unit",
          "type": "string"
        },
        "operating_condition_mode": {
          "const": "PER_LIBRARY_NOMINAL",
          "title": "Operating Condition Mode",
          "type": "string"
        },
        "operating_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Operating Conditions",
          "type": "array"
        },
        "role": {
          "enum": [
            "SETUP",
            "HOLD",
            "REFERENCE"
          ],
          "title": "Role",
          "type": "string"
        },
        "temperature_c": {
          "title": "Temperature C",
          "type": "number"
        },
        "voltage_v": {
          "exclusiveMinimum": 0,
          "title": "Voltage V",
          "type": "number"
        }
      },
      "required": [
        "corner_id",
        "role",
        "library_model",
        "liberty_files",
        "operating_condition_mode",
        "operating_conditions",
        "voltage_v",
        "temperature_c",
        "native_time_unit"
      ],
      "title": "TimingCorner",
      "type": "object"
    },
    "ToolFingerprint": {
      "additionalProperties": false,
      "description": "Identity of the executable inspected by the doctor.",
      "properties": {
        "adapter_version": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}-v[1-9][0-9]*$",
          "title": "Adapter Version",
          "type": "string"
        },
        "build_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Hash",
          "type": "string"
        },
        "container_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "executable": {
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        },
        "executable_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executable Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Tool Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_args": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Version Args",
          "type": "array"
        }
      },
      "required": [
        "tool_id",
        "executable",
        "version",
        "version_args",
        "executable_sha256",
        "build_hash",
        "adapter_version"
      ],
      "title": "ToolFingerprint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pinned tool and ASAP7 platform realization consumed by later stages.",
  "properties": {
    "cell_lefs": {
      "items": {
        "$ref": "#/$defs/PlatformArtifact"
      },
      "minItems": 1,
      "title": "Cell Lefs",
      "type": "array"
    },
    "content_identity_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Identity Hash",
      "type": "string"
    },
    "deterministic_seed": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Deterministic Seed",
      "type": "integer"
    },
    "flow_config": {
      "$ref": "#/$defs/PlatformArtifact"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "hold_corner": {
      "$ref": "#/$defs/TimingCorner"
    },
    "host": {
      "$ref": "#/$defs/HostPlatform"
    },
    "license_artifacts": {
      "items": {
        "$ref": "#/$defs/PlatformArtifact"
      },
      "minItems": 1,
      "title": "License Artifacts",
      "type": "array"
    },
    "license_notes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "License Notes",
      "type": "array"
    },
    "orfs_commit": {
      "title": "Orfs Commit",
      "type": "string"
    },
    "orfs_tree_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Orfs Tree Identity",
      "type": "string"
    },
    "platform_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Platform Id",
      "type": "string"
    },
    "rc_rules": {
      "$ref": "#/$defs/PlatformArtifact"
    },
    "redistribution_status": {
      "enum": [
        "PERMITTED",
        "REVIEW_REQUIRED",
        "RESTRICTED"
      ],
      "title": "Redistribution Status",
      "type": "string"
    },
    "reference_corner": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimingCorner"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Selection Policy Hash",
      "type": "string"
    },
    "setup_corner": {
      "$ref": "#/$defs/TimingCorner"
    },
    "source_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Manifest Hash",
      "type": "string"
    },
    "tech_lef": {
      "$ref": "#/$defs/PlatformArtifact"
    },
    "tool_fingerprints": {
      "items": {
        "$ref": "#/$defs/ToolFingerprint"
      },
      "minItems": 1,
      "title": "Tool Fingerprints",
      "type": "array"
    }
  },
  "required": [
    "platform_id",
    "source_manifest_hash",
    "selection_policy_hash",
    "orfs_commit",
    "orfs_tree_identity",
    "host",
    "tool_fingerprints",
    "setup_corner",
    "hold_corner",
    "reference_corner",
    "tech_lef",
    "cell_lefs",
    "rc_rules",
    "flow_config",
    "license_artifacts",
    "redistribution_status",
    "license_notes",
    "deterministic_seed",
    "content_identity_hash",
    "generated_at"
  ],
  "title": "PlatformLock",
  "type": "object"
}
