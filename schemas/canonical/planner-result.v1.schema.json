{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "description": "Stable machine-readable finding with evidence-linked human context.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "FATAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "evidence_refs"
      ],
      "title": "Diagnostic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_pack_hashes": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Context Pack Hashes",
      "type": "array"
    },
    "council_result_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Council Result Id"
    },
    "fallback_used": {
      "title": "Fallback Used",
      "type": "boolean"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Id"
    },
    "opportunity_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Opportunity Id",
      "type": "string"
    },
    "output_schema_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Schema Hash",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "planner_mode": {
      "enum": [
        "HEURISTIC",
        "SINGLE_AGENT",
        "AGENT_COUNCIL"
      ],
      "title": "Planner Mode",
      "type": "string"
    },
    "planner_result_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Planner Result Id",
      "type": "string"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Hash"
    },
    "proposal_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Proposal Ids",
      "type": "array"
    },
    "provider_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Id"
    },
    "rejected_output_diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Rejected Output Diagnostics",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "NO_SAFE_PROPOSAL",
        "PARTIAL",
        "PROVIDER_ERROR",
        "SCHEMA_ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "upstream_provider_result_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Upstream Provider Result Id"
    }
  },
  "required": [
    "planner_result_id",
    "run_id",
    "opportunity_id",
    "planner_mode",
    "status",
    "proposal_ids",
    "rejected_output_diagnostics",
    "context_pack_hashes",
    "council_result_id",
    "provider_id",
    "model_id",
    "prompt_hash",
    "output_schema_hash",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "fallback_used",
    "upstream_provider_result_id"
  ],
  "title": "PlannerResult",
  "type": "object"
}
