{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CalibrationSample": {
      "additionalProperties": false,
      "description": "One bounded benchmark scale observation.",
      "properties": {
        "config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "mapped_cell_count": {
          "exclusiveMinimum": 0,
          "title": "Mapped Cell Count",
          "type": "integer"
        },
        "recipe_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Recipe Hash",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "stage_result_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "tool_fingerprint": {
          "$ref": "#/$defs/ToolFingerprint"
        },
        "workload_scale": {
          "exclusiveMinimum": 0,
          "title": "Workload Scale",
          "type": "integer"
        }
      },
      "required": [
        "workload_scale",
        "mapped_cell_count",
        "config_hash",
        "source_hash",
        "snapshot_hash",
        "recipe_hash",
        "tool_fingerprint",
        "stage_result_artifact"
      ],
      "title": "CalibrationSample",
      "type": "object"
    },
    "MappedCellTarget": {
      "additionalProperties": false,
      "description": "Inclusive mapped standard-cell target used by later calibration.",
      "properties": {
        "maximum": {
          "exclusiveMinimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "exclusiveMinimum": 0,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "MappedCellTarget",
      "type": "object"
    },
    "ToolFingerprint": {
      "additionalProperties": false,
      "description": "Identity of the executable inspected by the doctor.",
      "properties": {
        "adapter_version": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}-v[1-9][0-9]*$",
          "title": "Adapter Version",
          "type": "string"
        },
        "build_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Hash",
          "type": "string"
        },
        "container_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "executable": {
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        },
        "executable_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executable Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Tool Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_args": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Version Args",
          "type": "array"
        }
      },
      "required": [
        "tool_id",
        "executable",
        "version",
        "version_args",
        "executable_sha256",
        "build_hash",
        "adapter_version"
      ],
      "title": "ToolFingerprint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bounded calibration evidence for the full benchmark cell-count target.",
  "properties": {
    "report_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/CalibrationSample"
      },
      "title": "Samples",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_workload_scale": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Workload Scale"
    },
    "status": {
      "enum": [
        "PASS",
        "TARGET_NOT_REACHED",
        "BUDGET_EXHAUSTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/MappedCellTarget"
    }
  },
  "required": [
    "target",
    "samples",
    "selected_workload_scale",
    "status",
    "report_hash"
  ],
  "title": "CalibrationReport",
  "type": "object"
}
