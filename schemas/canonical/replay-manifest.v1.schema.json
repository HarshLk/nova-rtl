{
  "additionalProperties": false,
  "properties": {
    "event_artifact_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Event Artifact Ids",
      "type": "array"
    },
    "external_calls_allowed": {
      "const": false,
      "default": false,
      "title": "External Calls Allowed",
      "type": "boolean"
    },
    "ledger_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ledger Hash",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "replay_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Replay Id",
      "type": "string"
    },
    "required_artifact_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Artifact Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "terminal_state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Terminal State Hash",
      "type": "string"
    }
  },
  "required": [
    "replay_id",
    "run_id",
    "event_artifact_ids",
    "required_artifact_ids",
    "ledger_hash",
    "terminal_state_hash",
    "manifest_hash"
  ],
  "title": "ReplayManifest",
  "type": "object"
}
