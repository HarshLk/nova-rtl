{
  "additionalProperties": false,
  "description": "Immutable identity and location of exact artifact bytes.",
  "properties": {
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED_RTL"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "media_type": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
      "title": "Media Type",
      "type": "string"
    },
    "producer_stage_result_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Producer Stage Result Id"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "uri": {
      "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "uri",
    "sha256",
    "media_type",
    "size_bytes",
    "created_at",
    "producer_stage_result_id",
    "classification"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
