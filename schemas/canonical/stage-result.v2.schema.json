{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "Stable machine-readable finding with evidence-linked human context.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "FATAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "evidence_refs"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "MetricSet": {
      "additionalProperties": false,
      "description": "Complete, unit-explicit measured metrics for a stage or comparison.",
      "properties": {
        "analysis_view_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis View Id"
        },
        "buffer_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Buffer Count"
        },
        "cell_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Count"
        },
        "congestion_overflow": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Congestion Overflow"
        },
        "critical_path_delay_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Critical Path Delay Ns"
        },
        "estimated_fmax_mhz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Fmax Mhz"
        },
        "failing_endpoints": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failing Endpoints"
        },
        "hold_tns_ns": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hold Tns Ns"
        },
        "hold_wns_ns": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hold Wns Ns"
        },
        "mapped_area_um2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mapped Area Um2"
        },
        "missing_metric_reasons": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Metric Reasons",
          "type": "object"
        },
        "physical_area_um2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Physical Area Um2"
        },
        "power_total_uw": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Power Total Uw"
        },
        "register_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Register Count"
        },
        "runtime_ms": {
          "minimum": 0,
          "title": "Runtime Ms",
          "type": "integer"
        },
        "setup_tns_ns": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Setup Tns Ns"
        },
        "setup_wns_ns": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Setup Wns Ns"
        },
        "wirelength_um": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wirelength Um"
        }
      },
      "required": [
        "analysis_view_id",
        "setup_wns_ns",
        "setup_tns_ns",
        "hold_wns_ns",
        "hold_tns_ns",
        "failing_endpoints",
        "critical_path_delay_ns",
        "estimated_fmax_mhz",
        "mapped_area_um2",
        "physical_area_um2",
        "cell_count",
        "register_count",
        "buffer_count",
        "power_total_uw",
        "wirelength_um",
        "congestion_overflow",
        "runtime_ms",
        "missing_metric_reasons"
      ],
      "title": "MetricSet",
      "type": "object"
    },
    "StageInputHashes": {
      "additionalProperties": false,
      "description": "Named cache and comparability identities shared by deterministic stages.",
      "properties": {
        "analysis_view": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis View"
        },
        "constraint_binding": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Constraint Binding"
        },
        "constraints": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Constraints"
        },
        "design_contract": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Design Contract"
        },
        "extensions": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Extensions",
          "type": "object"
        },
        "formal_model": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Formal Model"
        },
        "parent_stage_result": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Stage Result"
        },
        "platform_lock": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Platform Lock"
        },
        "power_activity": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Power Activity"
        },
        "rtl_snapshot": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rtl Snapshot"
        },
        "tool_recipe": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Recipe"
        }
      },
      "required": [
        "rtl_snapshot",
        "design_contract",
        "constraints",
        "constraint_binding",
        "analysis_view",
        "power_activity",
        "platform_lock",
        "tool_recipe",
        "formal_model",
        "parent_stage_result",
        "extensions"
      ],
      "title": "StageInputHashes",
      "type": "object"
    },
    "ToolFingerprint": {
      "additionalProperties": false,
      "description": "Identity of the executable inspected by the doctor.",
      "properties": {
        "adapter_version": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}-v[1-9][0-9]*$",
          "title": "Adapter Version",
          "type": "string"
        },
        "build_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Hash",
          "type": "string"
        },
        "container_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "executable": {
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        },
        "executable_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executable Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Tool Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_args": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Version Args",
          "type": "array"
        }
      },
      "required": [
        "tool_id",
        "executable",
        "version",
        "version_args",
        "executable_sha256",
        "build_hash",
        "adapter_version"
      ],
      "title": "ToolFingerprint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical validated outcome of a deterministic gate or tool stage.",
  "properties": {
    "analysis_view_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis View Id"
    },
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "input_hashes": {
      "$ref": "#/$defs/StageInputHashes"
    },
    "metrics": {
      "$ref": "#/$defs/MetricSet"
    },
    "raw_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Raw Artifacts",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "RTL_PARSE",
        "YOSYS_SYNTH",
        "CONSTRAINT_BINDING",
        "CLOCK_INVENTORY",
        "CDC_INVARIANT",
        "FORMAL_MODEL_PREFLIGHT",
        "EQY_SMOKE",
        "FAST_SYNTH",
        "OPENSTA_FULL",
        "OPENROAD_PHYSICAL",
        "OPENROAD_PLACED_CTS",
        "OPENROAD_ROUTED",
        "FORMAL_EQUIVALENCE",
        "SIMULATION",
        "POWER_ANALYSIS"
      ],
      "title": "Stage",
      "type": "string"
    },
    "stage_result_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Stage Result Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "INFRASTRUCTURE_ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_fingerprint": {
      "$ref": "#/$defs/ToolFingerprint"
    }
  },
  "required": [
    "stage_result_id",
    "run_id",
    "candidate_id",
    "stage",
    "analysis_view_id",
    "status",
    "tool_fingerprint",
    "input_hashes",
    "metrics",
    "diagnostics",
    "raw_artifacts",
    "started_at",
    "ended_at"
  ],
  "title": "StageResult",
  "type": "object"
}
