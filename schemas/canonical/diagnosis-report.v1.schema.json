{
  "$defs": {
    "EvidenceBackedClaim": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "evidence_refs"
      ],
      "title": "EvidenceBackedClaim",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Stable semantic evidence address within an immutable snapshot.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "kind": {
          "enum": [
            "PATH",
            "ARC",
            "CONE",
            "SOURCE_SPAN",
            "CLOCK",
            "CDC",
            "BINDING",
            "PHYSICAL",
            "FORMAL",
            "METRIC",
            "HISTORY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "artifact_id",
        "json_pointer",
        "snapshot_hash"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "PlanningRootCause": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "category",
        "confidence"
      ],
      "title": "PlanningRootCause",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/EvidenceBackedClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "diagnosis_report_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Diagnosis Report Id",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "ACTIONABLE",
        "NO_RTL_ACTION",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "editability": {
      "enum": [
        "RTL_EDITABLE",
        "PROTECTED_OR_UNSAFE",
        "NO_RTL_ACTION",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "Editability",
      "type": "string"
    },
    "opportunity_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Opportunity Id",
      "type": "string"
    },
    "planner_request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Planner Request Id",
      "type": "string"
    },
    "ranked_root_causes": {
      "items": {
        "$ref": "#/$defs/PlanningRootCause"
      },
      "title": "Ranked Root Causes",
      "type": "array"
    },
    "role": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Role",
      "type": "string"
    },
    "safety_assessment": {
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
      "title": "Safety Assessment",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "uncertainties": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "diagnosis_report_id",
    "planner_request_id",
    "role",
    "opportunity_id",
    "snapshot_hash",
    "ranked_root_causes",
    "editability",
    "safety_assessment",
    "claims",
    "uncertainties",
    "disposition"
  ],
  "title": "DiagnosisReport",
  "type": "object"
}
