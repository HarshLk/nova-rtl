{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "context_request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Context Request Id",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "planner_request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Planner Request Id",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "provider_configuration_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Provider Configuration Hash",
      "type": "string"
    },
    "provider_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_result_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Provider Result Id",
      "type": "string"
    },
    "requested_schema_name": {
      "pattern": "^[a-z][a-z0-9-]{2,95}$",
      "title": "Requested Schema Name",
      "type": "string"
    },
    "requested_schema_version": {
      "exclusiveMinimum": 0,
      "title": "Requested Schema Version",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "INVALID_OUTPUT",
        "PROVIDER_ERROR",
        "TIMEOUT",
        "BUDGET_EXHAUSTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "structured_output_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "structured_output_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Structured Output Hash"
    }
  },
  "required": [
    "provider_result_id",
    "planner_request_id",
    "context_request_id",
    "status",
    "provider_id",
    "model_id",
    "provider_configuration_hash",
    "prompt_hash",
    "requested_schema_name",
    "requested_schema_version",
    "structured_output_artifact",
    "structured_output_hash",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "error_code",
    "completed_at"
  ],
  "title": "ProviderResult",
  "type": "object"
}
