{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exact activity source and semantics required for comparable power evidence.",
  "properties": {
    "comparability": {
      "enum": [
        "OFFICIAL_COMPARABLE",
        "ESTIMATED_ONLY_NOT_COMPARABLE"
      ],
      "title": "Comparability",
      "type": "string"
    },
    "contract_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "format": {
      "enum": [
        "VCD",
        "SAIF",
        "VECTORLESS"
      ],
      "title": "Format",
      "type": "string"
    },
    "power_activity_contract_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Power Activity Contract Id",
      "type": "string"
    },
    "propagation_policy": {
      "enum": [
        "ANNOTATED",
        "PROPAGATED",
        "VECTORLESS_ESTIMATE"
      ],
      "title": "Propagation Policy",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.$/]*$",
      "title": "Scope",
      "type": "string"
    },
    "source_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_window_ns": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "minimum": 0,
          "type": "number"
        }
      ],
      "title": "Time Window Ns",
      "type": "array"
    }
  },
  "required": [
    "power_activity_contract_id",
    "format",
    "source_artifact",
    "scope",
    "time_window_ns",
    "propagation_policy",
    "comparability",
    "contract_hash"
  ],
  "title": "PowerActivityContract",
  "type": "object"
}
