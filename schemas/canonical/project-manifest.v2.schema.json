          "const": "STRICT_SEQ_EQUIV",
          "title": "Primary Competition Contract",
          "type": "string"
        },
        "prohibit_assumption_only_equivalence": {
          "const": true,
          "title": "Prohibit Assumption Only Equivalence",
          "type": "boolean"
        },
        "proof_scope_policy": {
          "const": "WHOLE_DESIGN_OR_COMPOSITIONALLY_CLOSED",
