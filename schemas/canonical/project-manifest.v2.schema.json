{
  "$defs": {
    "AnalysisViewManifest": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "SETUP",
            "HOLD",
            "POWER"
          ],
          "title": "Check",
          "type": "string"
        },
        "clock_uncertainty_policy": {
          "title": "Clock Uncertainty Policy",
          "type": "string"
        },
        "derate_policy": {
          "title": "Derate Policy",
          "type": "string"
        },
        "hard_limits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Hard Limits",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "liberty_corner": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Liberty Corner",
          "type": "string"
        },
        "mode": {
          "const": "FUNCTIONAL",
          "title": "Mode",
          "type": "string"
        },
        "operating_condition": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Operating Condition",
          "type": "string"
        },
        "rc_corner": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Rc Corner",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "required_stages": {
          "items": {
            "enum": [
              "OPENSTA_FULL",
              "OPENROAD_PHYSICAL",
              "OPENROAD_PLACED_CTS",
              "OPENROAD_ROUTED"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Stages",
          "type": "array"
        },
        "sdc": {
          "title": "Sdc",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mode",
        "check",
        "liberty_corner",
        "rc_corner",
        "operating_condition",
        "derate_policy",
        "clock_uncertainty_policy",
        "hard_limits",
        "sdc",
        "required_stages",
        "required"
      ],
      "title": "AnalysisViewManifest",
      "type": "object"
    },
    "CdcPolicy": {
      "additionalProperties": false,
      "properties": {
        "approved_pattern_registry": {
          "title": "Approved Pattern Registry",
          "type": "string"
        },
        "checker_mode": {
          "const": "STRUCTURAL_INVARIANT_AUDIT",
          "title": "Checker Mode",
          "type": "string"
        },
        "external_cdc_tool": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Cdc Tool"
        },
        "protocol_property_manifest": {
          "title": "Protocol Property Manifest",
          "type": "string"
        },
        "require_candidate_inventory_equivalence": {
          "const": true,
          "title": "Require Candidate Inventory Equivalence",
          "type": "boolean"
        },
        "require_zero_unapproved_crossings": {
          "const": true,
          "title": "Require Zero Unapproved Crossings",
          "type": "boolean"
        }
      },
      "required": [
        "checker_mode",
        "approved_pattern_registry",
        "require_zero_unapproved_crossings",
        "require_candidate_inventory_equivalence",
        "protocol_property_manifest",
        "external_cdc_tool"
      ],
      "title": "CdcPolicy",
      "type": "object"
    },
    "CompilationProfiles": {
      "additionalProperties": false,
      "properties": {
