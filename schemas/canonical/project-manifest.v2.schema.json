    "ConstraintPolicy": {
      "additionalProperties": false,
      "properties": {
        "expected_generated_clocks_per_master": {
          "exclusiveMinimum": 0,
          "title": "Expected Generated Clocks Per Master",
          "type": "integer"
        },
        "expected_master_clocks": {
          "const": 5,
          "title": "Expected Master Clocks",
          "type": "integer"
        },
        "immutable": {
          "title": "Immutable",
          "type": "boolean"
        },
        "require_constraint_binding_equivalence": {
          "const": true,
          "title": "Require Constraint Binding Equivalence",
          "type": "boolean"
        },
        "require_exception_coverage_equivalence": {
          "const": true,
          "title": "Require Exception Coverage Equivalence",
          "type": "boolean"
        },
        "require_zero_unconstrained_endpoints": {
          "const": true,
          "title": "Require Zero Unconstrained Endpoints",
          "type": "boolean"
        },
        "sdc": {
          "title": "Sdc",
          "type": "string"
        }
      },
      "required": [
        "sdc",
        "immutable",
        "expected_master_clocks",
        "expected_generated_clocks_per_master",
        "require_zero_unconstrained_endpoints",
        "require_constraint_binding_equivalence",
        "require_exception_coverage_equivalence"
      ],
      "title": "ConstraintPolicy",
      "type": "object"
    },
    "ContextIsolationPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_read_only_retrieval": {
          "const": true,
          "title": "Allow Read Only Retrieval",
          "type": "boolean"
        },
        "blind_independent_round": {
          "const": true,
          "title": "Blind Independent Round",
          "type": "boolean"
        },
        "blind_parallel_critics": {
          "const": true,
          "title": "Blind Parallel Critics",
          "type": "boolean"
        },
        "chair_pack_max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Chair Pack Max Tokens",
          "type": "integer"
        },
        "mode": {
          "const": "ROLE_SCOPED_EVIDENCE_PACKS",
          "title": "Mode",
          "type": "string"
        },
        "private_pack_max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Private Pack Max Tokens",
          "type": "integer"
        },
        "randomize_neutral_proposal_order": {
          "const": true,
          "title": "Randomize Neutral Proposal Order",
          "type": "boolean"
        },
        "require_snapshot_hash_match": {
          "const": true,
          "title": "Require Snapshot Hash Match",
          "type": "boolean"
        },
        "shared_envelope_max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Shared Envelope Max Tokens",
          "type": "integer"
        }
