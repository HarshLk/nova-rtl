      "required": [
        "mode",
        "shared_envelope_max_tokens",
        "private_pack_max_tokens",
        "chair_pack_max_tokens",
        "allow_read_only_retrieval",
        "require_snapshot_hash_match",
        "blind_independent_round",
        "blind_parallel_critics",
        "randomize_neutral_proposal_order"
      ],
      "title": "ContextIsolationPolicy",
      "type": "object"
