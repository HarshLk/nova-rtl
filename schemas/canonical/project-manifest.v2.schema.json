        "generated_clock_model",
        "sby_multiclock",
        "reset_assumption_manifest",
        "prohibit_assumption_only_equivalence"
      ],
      "title": "FormalPolicy",
      "type": "object"
    },
    "FunctionalCompilationProfile": {
      "additionalProperties": false,
      "properties": {
        "defines": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*(?:=.*)?$",
            "type": "string"
          },
          "title": "Defines",
          "type": "array"
        },
        "parameters": {
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_$]*$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "defines",
        "parameters"
      ],
      "title": "FunctionalCompilationProfile",
      "type": "object"
    },
