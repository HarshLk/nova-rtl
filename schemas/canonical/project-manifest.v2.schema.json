          "type": "string"
        },
        "require_primary_latency_preserving_candidate": {
          "const": true,
          "title": "Require Primary Latency Preserving Candidate",
          "type": "boolean"
        },
        "reset_assumption_manifest": {
          "title": "Reset Assumption Manifest",
          "type": "string"
