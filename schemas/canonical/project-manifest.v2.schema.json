          "minItems": 1,
          "title": "Property Files",
          "type": "array"
        },
        "property_only_define": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
          "title": "Property Only Define",
          "type": "string"
        },
        "require_functional_logic_hash_match": {
          "const": true,
          "title": "Require Functional Logic Hash Match",
          "type": "boolean"
        }
