    "FormalCompilationProfile": {
      "additionalProperties": false,
      "properties": {
        "disallow_design_behavior_defines": {
          "const": true,
          "title": "Disallow Design Behavior Defines",
          "type": "boolean"
        },
        "harness_manifest": {
          "title": "Harness Manifest",
          "type": "string"
        },
        "property_files": {
          "items": {
            "type": "string"
