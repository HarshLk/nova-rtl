    "FormalPolicy": {
      "additionalProperties": false,
      "properties": {
        "asynchronous_master_clocks": {
          "const": 5,
          "title": "Asynchronous Master Clocks",
          "type": "integer"
        },
        "generated_clock_model": {
          "const": "DERIVED_FROM_PROTECTED_DIVIDER_STATE",
