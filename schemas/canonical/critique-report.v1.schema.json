{
  "$defs": {
    "CritiqueObjection": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Category",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "objection_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Objection Id",
          "type": "string"
        },
        "requested_disposition": {
          "enum": [
            "ACCEPT",
            "REVISE",
            "REJECT"
          ],
          "title": "Requested Disposition",
          "type": "string"
        },
        "severity": {
          "enum": [
            "MANDATORY",
            "ADVISORY"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "objection_id",
        "severity",
        "category",
        "message",
        "evidence_refs",
        "requested_disposition"
      ],
      "title": "CritiqueObjection",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Stable semantic evidence address within an immutable snapshot.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "kind": {
          "enum": [
            "PATH",
            "ARC",
            "CONE",
            "SOURCE_SPAN",
            "CLOCK",
            "CDC",
            "BINDING",
            "PHYSICAL",
            "FORMAL",
            "METRIC",
            "HISTORY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "artifact_id",
        "json_pointer",
        "snapshot_hash"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "critic_class": {
      "enum": [
        "FORMAL",
        "PPA"
      ],
      "title": "Critic Class",
      "type": "string"
    },
    "critic_role": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Critic Role",
      "type": "string"
    },
    "critique_report_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Critique Report Id",
      "type": "string"
    },
    "objections": {
      "items": {
        "$ref": "#/$defs/CritiqueObjection"
      },
      "title": "Objections",
      "type": "array"
    },
    "proposal_card_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Proposal Card Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "critique_report_id",
    "critic_role",
    "critic_class",
    "proposal_card_id",
    "objections"
  ],
  "title": "CritiqueReport",
  "type": "object"
}
