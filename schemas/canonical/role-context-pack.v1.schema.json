{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable identity and location of exact artifact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED_RTL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "producer_stage_result_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Stage Result Id"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://[a-zA-Z0-9._/-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "size_bytes",
        "created_at",
        "producer_stage_result_id",
        "classification"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "common_envelope_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "common_envelope_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Common Envelope Hash",
      "type": "string"
    },
    "context_request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Context Request Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "estimated_tokens": {
      "minimum": 0,
      "title": "Estimated Tokens",
      "type": "integer"
    },
    "private_pack_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "private_pack_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Private Pack Hash",
      "type": "string"
    },
    "rendered_message_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "rendered_message_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rendered Message Hash",
      "type": "string"
    },
    "retrieval_grants": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Retrieval Grants",
      "type": "array"
    },
    "role": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Role",
      "type": "string"
    },
    "role_context_pack_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Role Context Pack Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "role_context_pack_id",
    "context_request_id",
    "role",
    "common_envelope_artifact",
    "common_envelope_hash",
    "private_pack_artifact",
    "private_pack_hash",
    "retrieval_grants",
    "rendered_message_artifact",
    "rendered_message_hash",
    "estimated_tokens",
    "created_at"
  ],
  "title": "RoleContextPack",
  "type": "object"
}
