# NOVA benchmark constraints; generated deterministically from benchmark configuration.
# Stable selectors are mirrored in expected/constraint_contract.json.

create_clock -name clk_ingress -period 5 -waveform {0 2.5} [get_ports clk_ingress]
create_clock -name clk_schedule -period 5 -waveform {0 2.5} [get_ports clk_schedule]
create_clock -name clk_dma -period 5 -waveform {0 2.5} [get_ports clk_dma]
create_clock -name clk_compute -period 5 -waveform {0 2.5} [get_ports clk_compute]
create_clock -name clk_control -period 5 -waveform {0 2.5} [get_ports clk_control]

# The five master domains are mutually asynchronous.
set_clock_groups -asynchronous -group [get_clocks clk_ingress] -group [get_clocks clk_schedule] -group [get_clocks clk_dma] -group [get_clocks clk_compute] -group [get_clocks clk_control]

# Generated clocks preserve divider waveform semantics.
